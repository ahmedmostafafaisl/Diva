            //     }
            // }


             if (isset($post['file_urls']) && is_array($post['file_urls'])) {
                $post['file_urls'] = array_map(function ($url) {
                    return str_replace('3.73.173.183', 'centerialmall.com', $url);
                }, $post['file_urls']);
            }
            return $post;
        });
    }
    
