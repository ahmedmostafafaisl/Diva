            ]
        ];
        // dd($data);
        $result = [];
        /////////////
        $woocommerceUrl = 'https://3.73.173.183/wp-json/wc/v3/orders';
        $consumerKey = 'ck_3ac0df7ec455715d7173bef920c7a779ac907c51';
