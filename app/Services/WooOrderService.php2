                        foreach ($item as $influencer) {

                            if ($influencer =  $inf) {
                                $follow = true;
                            }
                        }
                    }
                }
            }


            $post['follow'] = $follow;
            $post['user']['follow'] = $follow;
            // $follow = false;
            // // Check if user is authenticated and liked the post
